# Copy this to .env and fill in real values

DATABASE_URL=sqlite:///./digitalmarket.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-256-bit-random-key

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP email (use SendGrid, Resend, or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Business rules (can override defaults)
PLATFORM_COMMISSION_RATE=0.15
PRO_COMMISSION_RATE=0.10
PRO_SUBSCRIPTION_PRICE_CENTS=2900
FEATURED_LISTING_PRICE_CENTS=999
